{
  "name": "transicao-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Motor de carga, validador, schema e exportadores de treino do Transição (base: claude-coach, MIT)",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "schema": "ts-json-schema-generator --path src/schema/plano.ts --type TrainingPlan --tsconfig tsconfig.json --no-type-check -o ../schema/training-plan.schema.json"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.178.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ts-json-schema-generator": "^2.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
