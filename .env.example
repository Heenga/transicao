# ---------- Supabase (Project Settings → API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # chave "anon public"
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # chave "service_role" (NUNCA expor no navegador)

# ---------- Grupo ----------
# Código que cada amigo digita para criar a conta (grupo fechado)
GROUP_INVITE_CODE=troque-este-codigo
# Usuários com acesso de organizador (editar a prova, exportar dados do grupo). Separe por vírgula.
ADMIN_USERNAMES=henrique
# Máximo de contas no grupo
MAX_MEMBERS=4

# ---------- Anthropic (console.anthropic.com → API Keys) ----------
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-5-5
AI_MODEL_QUICK=claude-haiku-5-5

# ---------- Strava (strava.com/settings/api) ----------
STRAVA_CLIENT_ID=12345
STRAVA_CLIENT_SECRET=...
# Endereço público do app, sem barra no fim (ex: https://transicao.vercel.app)
APP_URL=http://localhost:3000
# Qualquer texto longo e aleatório: protege o retorno do login do Strava
STATE_SECRET=troque-por-um-texto-aleatorio-longo
